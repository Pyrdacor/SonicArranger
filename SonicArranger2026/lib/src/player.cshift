//! The replayer: turns a song of a module into 8-bit PCM samples, as SonicConvert 1.11 does (the C# library
//! SonicArranger of this repository: Stream, TrackState and PaulaState), which follows the Amiga replay routine of
//! Sonic Arranger (SONIC_ARRANGER.S, reconstructed from Ambermoon). It is a port of that code, value for value and in
//! the same order of floating point operations, so the samples are the same as those of SonicConvert, byte for byte;
//! even the noise, which comes from a port of System.Random with the same seed.
//!
//! Paula, the sound chip of the Amiga, plays a block of bytes per voice with the speed of its period, holding each
//! byte (or, optionally, interpolating). The interrupt (50 times a second by default) plays the next row every
//! `speed` ticks and the effects of the instruments in every tick.

namespace SonicArranger;

using System;

/// The periods of the 108 notes (1 to 108); 0 and the end marker 0xffff around them.
const ReadOnlySlice<int> NotePeriods = [
    0x0000,
    0x3580, 0x3280, 0x2fa0, 0x2d00, 0x2a60, 0x2800, 0x25c0, 0x23a0, 0x21a0, 0x1fc0, 0x1e00, 0x1c50,
    0x1ac0, 0x1940, 0x17d0, 0x1680, 0x1530, 0x1400, 0x12e0, 0x11d0, 0x10d0, 0x0fe0, 0x0f00, 0x0e28,
    0x0d60, 0x0ca0, 0x0be8, 0x0b40, 0x0a98, 0x0a00, 0x0970, 0x08e8, 0x0868, 0x07f0, 0x0780, 0x0714,
    0x06b0, 0x0650, 0x05f4, 0x05a0, 0x054c, 0x0500, 0x04b8, 0x0474, 0x0434, 0x03f8, 0x03c0, 0x038a,
    0x0358, 0x0328, 0x02fa, 0x02d0, 0x02a6, 0x0280, 0x025c, 0x023a, 0x021a, 0x01fc, 0x01e0, 0x01c5,
    0x01ac, 0x0194, 0x017d, 0x0168, 0x0153, 0x0140, 0x012e, 0x011d, 0x010d, 0x00fe, 0x00f0, 0x00e2,
    0x00d6, 0x00ca, 0x00be, 0x00b4, 0x00aa, 0x00a0, 0x0097, 0x008f, 0x0087, 0x007f, 0x0078, 0x0071,
    0x006b, 0x0065, 0x005f, 0x005a, 0x0055, 0x0050, 0x004b, 0x0047, 0x0043, 0x003f, 0x003c, 0x0038,
    0x0035, 0x0032, 0x002f, 0x002d, 0x002a, 0x0028, 0x0025, 0x0023, 0x0021, 0x001f, 0x001e, 0x001c,
    0xffff];

/// The vibrato: changes of the period, signed bytes.
const ReadOnlySlice<int> VibratoTable = [
    0x00, 0x03, 0x06, 0x09, 0x0c, 0x10, 0x13, 0x16, 0x19, 0x1c, 0x1f, 0x22, 0x25, 0x28, 0x2b, 0x2e,
    0x31, 0x34, 0x36, 0x39, 0x3c, 0x3f, 0x42, 0x44, 0x47, 0x49, 0x4c, 0x4e, 0x51, 0x53, 0x56, 0x58,
    0x5a, 0x5c, 0x5e, 0x60, 0x62, 0x64, 0x66, 0x68, 0x6a, 0x6c, 0x6d, 0x6f, 0x70, 0x72, 0x73, 0x74,
    0x76, 0x77, 0x78, 0x79, 0x7a, 0x7b, 0x7b, 0x7c, 0x7d, 0x7d, 0x7e, 0x7e, 0x7e, 0x7f, 0x7f, 0x7f,
    0x7f, 0x7f, 0x7f, 0x7f, 0x7e, 0x7e, 0x7d, 0x7d, 0x7c, 0x7c, 0x7b, 0x7a, 0x79, 0x78, 0x77, 0x76,
    0x75, 0x74, 0x72, 0x71, 0x70, 0x6e, 0x6c, 0x6b, 0x69, 0x67, 0x65, 0x63, 0x61, 0x5f, 0x5d, 0x5b,
    0x59, 0x57, 0x54, 0x52, 0x50, 0x4d, 0x4b, 0x48, 0x45, 0x43, 0x40, 0x3d, 0x3b, 0x38, 0x35, 0x32,
    0x2f, 0x2c, 0x29, 0x27, 0x24, 0x20, 0x1d, 0x1a, 0x17, 0x14, 0x11, 0x0e, 0x0b, 0x08, 0x05, 0x02,
    0xff, 0xfc, 0xf9, 0xf6, 0xf2, 0xef, 0xec, 0xe9, 0xe6, 0xe3, 0xe0, 0xdd, 0xda, 0xd7, 0xd4, 0xd1,
    0xce, 0xcb, 0xc9, 0xc6, 0xc3, 0xc0, 0xbe, 0xbb, 0xb8, 0xb6, 0xb3, 0xb1, 0xae, 0xac, 0xaa, 0xa8,
    0xa5, 0xa3, 0xa1, 0x9f, 0x9d, 0x9b, 0x99, 0x98, 0x96, 0x94, 0x93, 0x91, 0x90, 0x8e, 0x8d, 0x8c,
    0x8a, 0x89, 0x88, 0x87, 0x86, 0x86, 0x85, 0x84, 0x84, 0x83, 0x83, 0x82, 0x82, 0x82, 0x82, 0x82,
    0x82, 0x82, 0x82, 0x82, 0x82, 0x83, 0x83, 0x84, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8b,
    0x8c, 0x8d, 0x8f, 0x90, 0x92, 0x93, 0x95, 0x97, 0x98, 0x9a, 0x9c, 0x9e, 0xa0, 0xa2, 0xa4, 0xa6,
    0xa9, 0xab, 0xad, 0xb0, 0xb2, 0xb5, 0xb7, 0xba, 0xbc, 0xbf, 0xc2, 0xc4, 0xc7, 0xca, 0xcd, 0xd0,
    0xd3, 0xd6, 0xd9, 0xdb, 0xde, 0xe2, 0xe5, 0xe8, 0xeb, 0xee, 0xf1, 0xf4, 0xf7, 0xfa, 0xfd, 0x00];


/// A value as a signed byte (-128 to 127), wrapping around like a cast to sbyte in C#.
int S8(int value)
{
    return ((value & 0xff) ^ 0x80) - 0x80;
}


/// How the voices are written: one channel (all 4 voices), two (LRRL: voices 1 and 4 left, 2 and 3 right) or four.
enum ChannelMode : int32
{
    Mono = 1,
    Stereo = 2,
    Quad = 4
}


const double PalClock = 3546895.0;
const double NtscClock = 3579545.0;

/// The period of a note, 0 outside of the table.
int PeriodOf(int note)
{
    return note < 0 || note >= NotePeriods.Length ? 0 : NotePeriods[note];
}

/// A value as a signed 16-bit value, wrapping around like a cast to short in C#.
int S16(int value)
{
    return ((value & 0xffff) ^ 0x8000) - 0x8000;
}

/// A byte of the waves of a list (128 bytes each) as an unsigned value: like the original, an index past the end of
/// a wave reads the next one (the waves are one block of memory); 0 outside of all.
int WaveByte(List<uint8[]> waves, int wave, int index)
{
    int64 at = (int64)wave * 128 + index;
    if (at < 0 || at >= (int64)waves.Count() * 128)
        return 0;
    var data = waves[(int)(at / 128)];
    int i = (int)(at % 128);
    return i < data.Length ? data[i] : 0;
}

/// A byte of an array as a signed value, 0 outside of it.
int SignedByte(uint8[] data, int index)
{
    if (index < 0 || index >= data.Length)
        return 0;
    return S8(data[index]);
}

/// System.Random of .NET with a seed (Knuth's subtractive generator), so the noise is that of SonicConvert.
struct NetRandom
{
    int[] Seeds;
    int[] Positions;     // the two positions in Seeds (in an array: the state is shared by all copies)

    static NetRandom Create(int seed)
    {
        var r = NetRandom { Seeds = new int[56], Positions = new int[2] };
        r.Positions[1] = 21;
        int big = 2147483647;
        int subtraction = seed == -2147483648 ? big : Math.Abs(seed);
        int mj = 161803398 - subtraction;
        r.Seeds[55] = mj;
        int mk = 1;
        int ii = 0;
        for (var i = 1; i < 55; i += 1)
        {
            ii += 21;
            if (ii >= 55)
                ii -= 55;
            r.Seeds[ii] = mk;
            mk = mj - mk;
            if (mk < 0)
                mk += big;
            mj = r.Seeds[ii];
        }
        for (var k = 1; k < 5; k += 1)
        {
            for (var i = 1; i < 56; i += 1)
            {
                int n = i + 30;
                if (n >= 55)
                    n -= 55;
                r.Seeds[i] -= r.Seeds[1 + n];
                if (r.Seeds[i] < 0)
                    r.Seeds[i] += big;
            }
        }
        return r;
    }

    int Sample()
    {
        int big = 2147483647;
        int a = Positions[0] + 1;
        if (a >= 56)
            a = 1;
        int b = Positions[1] + 1;
        if (b >= 56)
            b = 1;
        int value = Seeds[a] - Seeds[b];
        if (value == big)
            value -= 1;
        if (value < 0)
            value += big;
        Seeds[a] = value;
        Positions[0] = a;
        Positions[1] = b;
        return value;
    }

    /// A number from 0 to max - 1, as Random.Next(max).
    int Next(int max)
    {
        return (int)(Sample() * (1.0 / 2147483647) * max);
    }
}

/// One of the 4 channels of Paula: the latched location (AUDxLC) and length in bytes (AUDxLEN * 2), the period
/// (AUDxPER), the volume (AUDxVOL), the DMA, and the block being played.
struct PaulaChannel
{
    uint8[] Data;
    int Offset;
    int Length;
    int Period;
    int Volume;
    bool Dma;
    uint8[] CurrentData;
    int CurrentOffset;
    int CurrentLength;
    double Position;
}

/// One voice of the replayer: the fields of the track structure of the Amiga routine.
struct PlayVoice
{
    uint8[] SynthWave;       // 128 bytes: the wave of a synth instrument, changed by its effects and played from here
    bool HasInstrument;
    int Instrument;          // 0-based
    int CurrNote;
    int PrevNote;
    int FineTuning;
    int PitchBend;
    int Volume;
    int VolumeSlide;
    int VibratoPos;
    int VibratoDelay;
    int PortamentoValue;
    int Portamento;
    int AdsrPos;
    int SustainPos;
    int AdsrDelay;
    int AmfPos;
    int AmfDelay;
    int SynthEffectPos;
    int SynthPos;
    int SynthDelay;
    int ArpeggioPos;
    int SimpleArpeggioPos;
    int VolumeLevel;         // for VU meters: 4 times the volume
    int Flags;               // bit 0: ended, 1: a morph reached its wave, 2: free negator ended, 3: oscillator direction
    bool SyntheticMode;
    bool SampleRepeat;
    Note RowNote;

    int Byte(int index)
    {
        return SignedByte(SynthWave, index);
    }

    void SetByte(int index, int value)
    {
        if (index >= 0 && index < SynthWave.Length)
            SynthWave[index] = (uint8)(value & 0xff);
    }
}

/// Plays a song of a module.
struct Player
{
    Module M;
    SongInfo Song;
    int SampleRate;
    ChannelMode Mode;
    int Channels;
    PaulaChannel[] Paula;
    PlayVoice[] Voices;
    uint8[] Silence;
    double Clock;
    bool AllowLowPassFilter;
    bool Interpolate;
    bool UseLowPassFilter;
    int MasterVolume;
    // the song state
    int Speed;
    int PatternLength;
    int OverLinePos;
    int OverPatternPos;
    int SongSpeedPos;
    int SyncValue;
    int CurrentPosition;
    NetRandom Noise;
    // the output: 2 seconds, read in parts of 1 second (as the Stream of SonicConvert)
    uint8[] Buffer;
    int BufferSampleIndex;
    double PlayTime;
    double NextInterruptTime;
    double InterruptDelay;
    bool HasEnd;
    int EndIndex;
    int Processed;
    int LoopCounter;
    // the low pass filters (one per output channel)
    double B0;
    double B1;
    double B2;
    double A1;
    double A2;
    double[] X1;
    double[] X2;
    double[] Y1;
    double[] Y2;

    /// A player for a song (0-based) of a module. The sample rate is 2000 to 200000 Hz. lowPassFilter allows the
    /// LED filter (the song switches it), interpolate interpolates the bytes linearly instead of holding them.
    static Error<Player> Create(Module m, int song, int sampleRate, ChannelMode mode, bool lowPassFilter, bool pal,
                                bool interpolate)
    {
        if (song < 0 || song >= m.Songs.Count())
            return error($"there is no song {song + 1}");
        if (sampleRate < 2000 || sampleRate > 200000)
            return error("the sample rate must be 2000 to 200000 Hz");
        var info = m.Songs[song];
        if (info.TicksPerSecond < 1 || info.TicksPerSecond > 200)
            return error("the song must have 1 to 200 ticks per second");
        if (info.Speed < 1 || info.Speed > 16)
            return error("the speed of the song must be 1 to 16");
        if (m.Positions() == 0)
            return error("the module has no positions");
        int channels = (int)mode;
        var p = Player { M = m, Song = info, SampleRate = sampleRate, Mode = mode, Channels = channels,
                         Paula = new PaulaChannel[4], Voices = new PlayVoice[4], Silence = new uint8[2],
                         Clock = pal ? PalClock : NtscClock, AllowLowPassFilter = lowPassFilter,
                         Interpolate = interpolate, MasterVolume = 63, Buffer = new uint8[2 * sampleRate * channels],
                         InterruptDelay = 1.0 / info.TicksPerSecond, X1 = new double[4], X2 = new double[4],
                         Y1 = new double[4], Y2 = new double[4] };
        // the LED filter: a second order Butterworth filter at 3275 Hz (bilinear transform with prewarping)
        double k = Math.Tan(Math.PI * 3275.0 / sampleRate);
        double k2 = k * k;
        double norm = 1.0 / (1.0 + Math.Sqrt(2.0) * k + k2);
        p.B0 = k2 * norm;
        p.B1 = 2.0 * p.B0;
        p.B2 = p.B0;
        p.A1 = 2.0 * (k2 - 1.0) * norm;
        p.A2 = (1.0 - Math.Sqrt(2.0) * k + k2) * norm;
        // as SA_LoadSong: the first interrupt starts the start position
        p.Speed = info.Speed;
        p.PatternLength = info.PatternLength;
        p.OverLinePos = info.StartPos - 1;
        p.SongSpeedPos = info.Speed;
        p.OverPatternPos = info.PatternLength;
        p.CurrentPosition = -1;
        p.Noise = NetRandom.Create(0x5a);
        for (var v = 0; v < 4; v += 1)
            p.Voices[v] = PlayVoice { SynthWave = new uint8[128], Flags = 1 };
        p.Load(0, sampleRate * 2, false);
        return p;
    }

    /// True when the song has been played to its end.
    bool EndOfStream()
    {
        return HasEnd && EndIndex == Processed;
    }

    /// The next second of samples (signed, interleaved), less at the end of the song. With loop, the song goes on
    /// at its repeat position after its end.
    uint8[] Read(bool loop)
    {
        int numSamples = SampleRate;
        int bufferIndex = BufferSampleIndex * Channels;
        int size = numSamples * Channels;
        bool end = false;
        if (HasEnd && size > EndIndex - Processed)
        {
            size = Math.Max(0, EndIndex - Processed);
            numSamples = size / Channels;
            end = true;
        }
        var data = new uint8[size];
        for (var i = 0; i < size; i += 1)
            data[i] = Buffer[bufferIndex + i];
        BufferSampleIndex += numSamples;
        Processed += size;
        if (!end && BufferSampleIndex > SampleRate)
        {
            // more than a second was read: the rest moves to the start and the buffer is filled up
            bufferIndex += size;
            int loaded = Buffer.Length - bufferIndex;
            for (var i = 0; i < loaded; i += 1)
                Buffer[i] = Buffer[bufferIndex + i];
            if (HasEnd)
            {
                int remaining = (EndIndex - Processed) - loaded;
                Load(loaded, Math.Min(remaining, (Buffer.Length - loaded) / Channels), loop);
            }
            else
                Load(loaded, (Buffer.Length - loaded) / Channels, loop);
            BufferSampleIndex = 0;
        }
        return data;
    }

    /// The whole song (played once, then loops more times), signed samples.
    uint8[] ReadAll(int loops)
    {
        var all = List<uint8>.Create(SampleRate * Channels * 60);
        while (!EndOfStream())
            all.AddRange(Read(loops > LoopCounter));
        return all.ToArray();
    }

    // ---- Paula ----

    void SetLocation(int channel, uint8[] data, int offset, int length)
    {
        Paula[channel].Data = data;
        Paula[channel].Offset = offset;
        Paula[channel].Length = length;
    }

    void LoadBlock(int channel)
    {
        Paula[channel].CurrentData = Paula[channel].Data;
        Paula[channel].CurrentOffset = Paula[channel].Offset;
        Paula[channel].CurrentLength = Paula[channel].Length;
    }

    void StartDma(int channel)
    {
        if (Paula[channel].Dma)
            return;
        Paula[channel].Dma = true;
        LoadBlock(channel);
        Paula[channel].Position = 0.0;
    }

    bool Playing(int channel)
    {
        return Paula[channel].Dma && Paula[channel].CurrentLength > 0 && Paula[channel].Period > 0;
    }

    double ChannelOutput(int channel)
    {
        if (!Playing(channel))
            return 0.0;
        var c = Paula[channel];
        int index = (int)c.Position;
        double value = SignedByte(c.CurrentData, c.CurrentOffset + index) / 128.0;
        if (Interpolate)
        {
            double next = index + 1 < c.CurrentLength ? SignedByte(c.CurrentData, c.CurrentOffset + index + 1) / 128.0
                                                       : SignedByte(c.Data, c.Offset) / 128.0;
            value += (c.Position - index) * (next - value);
        }
        return Math.Min(64, Math.Max(0, c.Volume)) * value / 64.0;
    }

    void AdvancePaula()
    {
        for (var channel = 0; channel < 4; channel += 1)
        {
            if (!Playing(channel))
                continue;
            Paula[channel].Position += Clock / Paula[channel].Period / SampleRate;
            while (Paula[channel].Position >= Paula[channel].CurrentLength)
            {
                Paula[channel].Position -= Paula[channel].CurrentLength;
                LoadBlock(channel);
                if (Paula[channel].CurrentLength <= 0)
                {
                    Paula[channel].Position = 0.0;
                    break;
                }
            }
        }
    }

    double Filtered(int filter, double value)
    {
        double output = B0 * value + B1 * X1[filter] + B2 * X2[filter] - A1 * Y1[filter] - A2 * Y2[filter];
        X2[filter] = X1[filter];
        X1[filter] = value;
        Y2[filter] = Y1[filter];
        Y1[filter] = output;
        if (AllowLowPassFilter && UseLowPassFilter)
            value = output;
        return Math.Max(-1.0, Math.Min(1.0, value));
    }

    static uint8 ToByte(double value)
    {
        double rounded = Math.Max(-128.0, Math.Min(127.0, Math.Round(value)));
        return (uint8)((int)rounded & 0xff);
    }

    // ---- a new row (SA_AdvanceTrack) ----

    // plays a row of the pattern for a voice; true when its DMA is turned on at the end of the interrupt
    bool AdvanceVoice(int t, ref PlayVoice c, Note note, int noteTranspose, int soundTranspose)
    {
        c.RowNote = note;
        bool startDma = false;
        int noteValue = note.Value;
        int number = note.Instrument;
        if (noteValue == 0)
        {
            if (number != 0)
                LoadTrackInst(t, ref c, number);
        }
        else if (noteValue == 0x80)
        {
            // hold (sustain)
        }
        else if (noteValue == 0x7f)
            ClrTrackInst(t, ref c);
        else
        {
            if (!note.NoNoteTranspose())
                noteValue += noteTranspose;
            if (number != 0 && !note.NoSoundTranspose())
                number += soundTranspose;
            number &= 0xff;
            c.PrevNote = c.CurrNote;
            c.CurrNote = noteValue;
            if (c.PrevNote == 0)
                c.PrevNote = noteValue;
            // a sample is started again from the beginning: the DMA goes off
            if (!c.SyntheticMode)
            {
                Paula[t].Dma = false;
                SetLocation(t, Paula[t].Data, Paula[t].Offset, 2);
                Paula[t].Period = 114;
            }
            if (number == 0)
            {
                if (!c.HasInstrument)
                {
                    // no instrument to play: the note command is not done
                    ClrTrackInst(t, ref c);
                    return false;
                }
                SetTrackInst(ref c);
            }
            else if (!LoadTrackInst(t, ref c, number))
                return false;
            c.SyntheticMode = M.Instruments[c.Instrument].IsSynth();
            startDma = c.SyntheticMode ? LoadTrackSynth(t, ref c) : LoadTrackSample(t, ref c);
        }
        ApplyNoteEffect(ref c, note);
        return startDma;
    }

    bool LoadTrackSample(int t, ref PlayVoice c)
    {
        var inst = M.Instruments[c.Instrument];
        int sample = inst.SampleWaveNo;
        if (sample < 0 || sample >= M.Samples.Count() || M.Samples[sample].Data.Length == 0)
        {
            ClrTrackInst(t, ref c);
            c.Flags |= 1;
            return false;
        }
        var data = M.Samples[sample].Data;
        int words = (inst.Length & 0xffff) + (inst.Repeat == 1 ? 0 : inst.Repeat & 0xffff);
        SetLocation(t, data, 0, Math.Min(words * 2, data.Length));
        // the repeat part is set in the next interrupt
        c.SampleRepeat = true;
        return true;
    }

    bool LoadTrackSynth(int t, ref PlayVoice c)
    {
        var inst = M.Instruments[c.Instrument];
        int words = inst.Length;
        SetLocation(t, c.SynthWave, 0, Math.Max(0, Math.Min(words * 2, c.SynthWave.Length)));
        // the wave is copied in blocks of 16 bytes
        int bytes = Math.Min(128, (((words - 1) >> 3) + 1) * 16);
        for (var i = 0; i < bytes; i += 1)
            c.SynthWave[i] = (uint8)WaveByte(M.Waves, inst.SampleWaveNo, i);
        c.SampleRepeat = false;
        return true;
    }

    // the interrupt after a sample was started: its repeat part from now on, or silence if its repeat is 1
    void RepeatSample(int t, ref PlayVoice c)
    {
        if (!c.SampleRepeat)
            return;
        c.SampleRepeat = false;
        if (!c.HasInstrument || M.Instruments[c.Instrument].Repeat == 0)
            return;
        var inst = M.Instruments[c.Instrument];
        bool hasData = inst.SampleWaveNo >= 0 && inst.SampleWaveNo < M.Samples.Count();
        if (inst.Repeat == 1 || !hasData)
        {
            SetLocation(t, Silence, 0, 2);
            return;
        }
        var data = M.Samples[inst.SampleWaveNo].Data;
        int start = (inst.Length & 0xffff) * 2;
        SetLocation(t, data, start, Math.Max(0, Math.Min((inst.Repeat & 0xffff) * 2, data.Length - start)));
    }

    bool LoadTrackInst(int t, ref PlayVoice c, int number)
    {
        if (number <= 0 || number > M.Instruments.Count())
        {
            ClrTrackInst(t, ref c);
            return false;
        }
        var inst = M.Instruments[number - 1];
        c.HasInstrument = true;
        c.Instrument = number - 1;
        c.Volume = inst.Volume;
        c.PortamentoValue = inst.Portamento;
        c.Portamento = 0;
        c.VibratoPos = 0;
        c.VibratoDelay = inst.VibDelay;
        SetTrackInst(ref c);
        return true;
    }

    void SetTrackInst(ref PlayVoice c)
    {
        var inst = M.Instruments[c.Instrument];
        c.FineTuning = S8(inst.FineTuning);
        c.AdsrDelay = inst.AdsrDelay;
        c.AdsrPos = 0;
        c.SustainPos = 0;
        c.AmfDelay = inst.AmfDelay;
        c.AmfPos = 0;
        c.SynthEffectPos = inst.Effect2;
        c.SynthPos = 0;
        c.SynthDelay = inst.EffectDelay;
        c.ArpeggioPos = 0;
        c.SimpleArpeggioPos = 0;
        c.VolumeLevel = ((c.Volume * MasterVolume) >> 6) * 4;
        c.Flags = 0;
    }

    void ClrTrackInst(int t, ref PlayVoice c)
    {
        Paula[t].Volume = 0;
        SetLocation(t, Silence, 0, 2);
        c.Volume = 0;
        c.VolumeLevel = 0;
        c.HasInstrument = false;
        c.SampleRepeat = false;
    }

    // ---- note commands (SA_ApplyNoteEffect) ----

    void ApplyNoteEffect(ref PlayVoice c, Note note)
    {
        c.PitchBend = 0;
        c.VolumeSlide = 0;
        int param = note.Param;
        int signedParam = S8(param);
        switch (note.Command())
        {
        case 0x1:
            c.PitchBend = signedParam;
            break;
        case 0x2:
            c.AdsrPos = param;
            break;
        case 0x4: // the vibrato starts now (speed and level stay those of the instrument)
            c.VibratoDelay = 0;
            break;
        case 0x5: // the sync value for the program that plays the music
            SyncValue = param;
            break;
        case 0x6:
            MasterVolume = param & 0x3f;
            break;
        case 0x7:
            c.PortamentoValue = param;
            break;
        case 0x8:
            c.PortamentoValue = 0;
            break;
        case 0x9:
            if (param > 0 && param <= 64)
                PatternLength = param;
            break;
        case 0xa:
            c.VolumeSlide = signedParam;
            break;
        case 0xb:
            OverLinePos = param - 1;
            OverPatternPos = PatternLength;
            break;
        case 0xc:
            c.Volume = Math.Min(64, param);
            c.VolumeLevel = ((MasterVolume * c.Volume) >> 6) * 4;
            break;
        case 0xd:
            OverPatternPos = PatternLength;
            break;
        case 0xe: // the power LED: 0 turns the filter on, other values turn it off
            UseLowPassFilter = param == 0;
            break;
        case 0xf:
            if (signedParam > 0 && signedParam <= 16)
                Speed = param;
            break;
        default:
            break;
        }
    }

    // ---- the bytes after the effect values of an instrument: the 3 arpeggio tables and the name ----

    static int ArpeggioByte(Instrument inst, int offset)
    {
        if (offset < 0)
            return 0;
        int table = offset / 16;
        if (table < 3)
        {
            var arp = inst.Arpeggios[table];
            int i = offset % 16;
            if (i == 0)
                return arp.Length;
            if (i == 1)
                return arp.Repeat;
            return i - 2 < arp.Data.Length ? arp.Data[i - 2] : 0;
        }
        // the name as SonicConvert reads it: up to the first zero, other bytes than ASCII as '?'
        int n = offset - 48;
        int length = 0;
        while (length < inst.Name.Length && inst.Name[length] != 0)
            length += 1;
        if (n >= length)
            return 0;
        return inst.Name[n] < 128 ? inst.Name[n] : 63;
    }

    // ---- every tick (SA_ProcessTrack) ----

    void ProcessVoice(int t, ref PlayVoice c)
    {
        if ((c.Flags & 1) != 0 || !c.HasInstrument)
        {
            Paula[t].Volume = 0;
            SetLocation(t, Silence, 0, 2);
            if (c.VolumeLevel != 0)
                c.VolumeLevel -= 4;
            return;
        }
        var inst = M.Instruments[c.Instrument];
        int note = c.CurrNote;
        int lastNote = c.PrevNote;
        int arpeggio = c.RowNote.Arpeggio();
        if (arpeggio != 0)
        {
            // the arpeggio table of the instrument: the notes are bytes
            int table = (arpeggio - 1) * 16;
            int offset = ArpeggioByte(inst, table + 2 + c.ArpeggioPos);
            note = (note & ~0xff) | ((note + offset) & 0xff);
            lastNote = (lastNote & ~0xff) | ((lastNote + offset) & 0xff);
            c.ArpeggioPos += 1;
            int length = ArpeggioByte(inst, table);
            if (((length + ArpeggioByte(inst, table + 1)) & 0xff) <= c.ArpeggioPos)
                c.ArpeggioPos = length;
        }
        else if (c.RowNote.Command() == 0 && c.RowNote.Param != 0)
        {
            // command 0: the note, the note + x semitones, the note + y semitones
            int add = 0;
            if (c.SimpleArpeggioPos == 0)
                c.SimpleArpeggioPos += 1;
            else if (c.SimpleArpeggioPos == 1)
            {
                c.SimpleArpeggioPos += 1;
                add = (c.RowNote.Param >> 4) & 0xf;
            }
            else
            {
                c.SimpleArpeggioPos = 0;
                add = c.RowNote.Param & 0xf;
            }
            note += add;
            lastNote += add;
        }

        int period = PeriodOf(note);
        int lastPeriod = PeriodOf(lastNote);

        // portamento: from the last note to this one
        if (c.PortamentoValue != 0)
        {
            if (c.Portamento == 0)
                c.Portamento = lastPeriod;
            lastPeriod = c.Portamento;
            if (Math.Abs(period - lastPeriod) - c.PortamentoValue < 0)
                c.PortamentoValue = 0;
            else
            {
                lastPeriod += lastPeriod < period ? c.PortamentoValue : -c.PortamentoValue;
                c.Portamento = lastPeriod;
                period = lastPeriod;
            }
        }

        // vibrato: after its delay in every tick; a delay with a low byte of 255 means no vibrato
        if ((c.VibratoDelay & 0xff) != 0xff)
        {
            if (c.VibratoDelay != 0)
                c.VibratoDelay -= 1;
            else
            {
                int level = inst.VibLevel;
                if (level != 0)
                    period += S8(VibratoTable[c.VibratoPos & 0xff]) * 4 / level;
                c.VibratoPos = (c.VibratoPos + inst.VibSpeed) & 0xff;
            }
        }

        // AMF: the period changes along a wave
        int amfTotal = (inst.AmfLength & 0xffff) + (inst.AmfRepeat & 0xffff);
        if ((amfTotal & 0xffff) != 0)
        {
            period -= S8(WaveByte(M.AmfWaves, inst.AmfWave, c.AmfPos));
            c.AmfDelay = (c.AmfDelay - 1) & 0xffff;
            if (c.AmfDelay == 0)
            {
                c.AmfDelay = inst.AmfDelay;
                c.AmfPos += 1;
                if (amfTotal <= c.AmfPos)
                    c.AmfPos = inst.AmfLength - (inst.AmfRepeat == 0 ? 1 : 0);
            }
        }

        period -= c.FineTuning;
        if (period < 113)
            period = 113;
        if (SongSpeedPos != 0)
            c.FineTuning += c.PitchBend;
        Paula[t].Period = period;

        if (inst.IsSynth())
            ApplySynthEffect(ref c, inst);

        // the volume, with the ADSR envelope
        int adsrTotal = (inst.AdsrLength & 0xffff) + (inst.AdsrRepeat & 0xffff);
        if ((adsrTotal & 0xffff) == 0)
        {
            Paula[t].Volume = (c.Volume * MasterVolume) >> 6;
            if (c.VolumeLevel != 0)
                c.VolumeLevel -= 4;
        }
        else
        {
            int adsr = (WaveByte(M.AdsrWaves, inst.AdsrWave, c.AdsrPos) * MasterVolume) >> 6;
            int vol = (c.Volume * adsr) >> 6;
            Paula[t].Volume = vol;
            c.VolumeLevel = vol * 4;
            bool step = true;
            // a held note (0x80) stays at the sustain point, or moves on every SustainVal ticks
            if (c.RowNote.Value == 0x80 && c.AdsrPos >= inst.SustainPt)
            {
                if (inst.SustainVal == 0)
                    step = false;
                else if (c.SustainPos != 0)
                {
                    c.SustainPos -= 1;
                    step = false;
                }
                else
                    c.SustainPos = inst.SustainVal;
            }
            if (step)
            {
                c.AdsrDelay = (c.AdsrDelay - 1) & 0xffff;
                if (c.AdsrDelay == 0)
                {
                    c.AdsrDelay = inst.AdsrDelay;
                    c.AdsrPos += 1;
                    if (adsrTotal <= c.AdsrPos)
                    {
                        c.AdsrPos = inst.AdsrLength - (inst.AdsrRepeat == 0 ? 1 : 0);
                        if (inst.AdsrRepeat == 0 && (adsr & 0xff) == 0)
                            c.Flags |= 1;
                    }
                }
            }
        }

        c.Volume = Math.Max(0, Math.Min(64, c.Volume + c.VolumeSlide));
    }

    // ---- the effects of synth instruments (SA_ApplySynthEffect) ----

    void ApplySynthEffect(ref PlayVoice c, Instrument inst)
    {
        c.SynthDelay = (c.SynthDelay - 1) & 0xffff;
        if (c.SynthDelay != 0)
            return;
        c.SynthDelay = inst.EffectDelay;
        int effect = inst.Effect;
        if (effect <= 0 || effect > 17)
            return;
        int e1 = inst.Effect1;
        int e2 = inst.Effect2;
        int e3 = inst.Effect3;
        bool advance = true;
        switch (effect)
        {
        case 1: // wave negator
            c.SetByte(c.SynthEffectPos, -c.Byte(c.SynthEffectPos));
            break;
        case 2: // free negator
        {
            advance = false;
            if ((c.Flags & 4) != 0)
                break;
            int offset = WaveByte(M.Waves, e1, c.SynthPos) & 0x7f;
            int length = (inst.Length * 2) & 0xffff;
            for (var i = offset; i < length; i += 1)
                c.SetByte(i, WaveByte(M.Waves, inst.SampleWaveNo, i));
            for (var i = 0; i < offset; i += 1)
                c.SetByte(i, -S8(WaveByte(M.Waves, inst.SampleWaveNo, i)));
            c.SynthPos += 1;
            if ((c.SynthPos & 0xffff) > ((e2 + e3) & 0xffff))
            {
                c.SynthPos = e2;
                if (e3 == 0 && offset == 0)
                    c.Flags |= 4;
            }
            break;
        }
        case 3: // rotate vertical
            for (var i = e2; i <= e3; i += 1)
                c.SetByte(i, c.Byte(i) + e1);
            break;
        case 4: // rotate horizontal: the bytes from Effect2 to Effect3 + 1 rotate by one
        {
            int first = c.Byte(e2);
            int i = e2;
            int count = e3 - e2;
            c.SetByte(i, c.Byte(i + 1));
            i += 1;
            count -= 1;
            while (count >= 0)
            {
                c.SetByte(i, c.Byte(i + 1));
                i += 1;
                count -= 1;
            }
            c.SetByte(i, first);
            break;
        }
        case 5: // alien voice
            advance = false;
            for (var i = e2; i <= e3; i += 1)
                c.SetByte(i, c.Byte(i) + WaveByte(M.Waves, e1, i));
            break;
        case 6: // poly negator
        {
            int pos = c.SynthEffectPos;
            c.SetByte(pos, WaveByte(M.Waves, inst.SampleWaveNo, pos));
            if (pos >= e3)
                pos = e2 - 1;
            c.SetByte(pos + 1, -c.Byte(pos + 1));
            break;
        }
        case 7: // shack wave 1
            ShackWave(ref c, e1, e2, e3);
            break;
        case 8: // shack wave 2
            ShackWave(ref c, e1, e2, e3);
            c.SetByte(e2 + c.SynthPos, -c.Byte(e2 + c.SynthPos));
            c.SynthPos += 1;
            if (e3 - e2 < c.SynthPos)
                c.SynthPos = 0;
            break;
        case 9: // metamorph: the wave changes step by step into the effect wave
            advance = false;
            if ((c.Flags & 2) == 0)
                Morph(ref c, e1, e2, e3);
            break;
        case 15: // oscillator 1: the wave changes into the effect wave and back, again and again
            advance = false;
            if ((c.Flags & 2) != 0)
            {
                c.Flags ^= 8;
                c.Flags &= ~2;
            }
            Morph(ref c, (c.Flags & 8) != 0 ? inst.SampleWaveNo : e1, e2, e3);
            break;
        case 10: // laser AMF
            if ((e3 & 0xffff) > (c.SynthPos & 0xffff))
            {
                c.FineTuning += S8(e2);
                c.SynthPos += 1;
            }
            break;
        case 11: // wave alias
            for (var i = e2; i <= e3; i += 1)
                c.SetByte(i, c.Byte(i) > c.Byte(i + 1) ? c.Byte(i) - e1 : c.Byte(i) + e1);
            break;
        case 12: // noise generator (the original uses the horizontal position of the beam)
            c.SetByte(c.SynthEffectPos, c.Byte(c.SynthEffectPos) ^ Noise.Next(256));
            break;
        case 16: // noise generator 2
            advance = false;
            for (var i = e3; i >= e2; i -= 1)
            {
                int value = (c.Byte(i) ^ 5) & 0xff;
                value = ((value << 2) | (value >> 6)) & 0xff;
                c.SetByte(i, value + Noise.Next(256));
            }
            break;
        case 13: // low pass filter 1
            LowPass(ref c, e2, e3, e1, -1, false);
            break;
        case 14: // low pass filter 2: the limits come from the effect wave, read from Effect3 on
            LowPass(ref c, e2, e3, 0, e1, true);
            break;
        case 17: // FM drum
            if ((e3 & 0xffff) <= (c.SynthPos & 0xffff))
            {
                c.FineTuning = inst.FineTuning;
                c.SynthPos = 0;
            }
            c.FineTuning = S16(c.FineTuning - (((e2 & 0xffff) * (e1 & 0xffff)) & 0xffff));
            c.SynthPos += 1;
            break;
        default:
            break;
        }
        if (advance)
        {
            c.SynthEffectPos += 1;
            if ((c.SynthEffectPos & 0xffff) > (e3 & 0xffff))
                c.SynthEffectPos = e2;
        }
    }

    // the same value of the effect wave is added to all bytes
    void ShackWave(ref PlayVoice c, int e1, int e2, int e3)
    {
        int value = WaveByte(M.Waves, e1, e2 + c.SynthEffectPos);
        for (var i = e2; i <= e3; i += 1)
            c.SetByte(i, c.Byte(i) + value);
    }

    // each byte moves one step towards the wave; when none moves, the morph has ended
    void Morph(ref PlayVoice c, int wave, int e2, int e3)
    {
        bool changed = false;
        for (var i = e2; i <= e3; i += 1)
        {
            int value = c.Byte(i);
            int target = S8(WaveByte(M.Waves, wave, i));
            if (value == target)
                continue;
            changed = true;
            c.SetByte(i, value < target ? value + 1 : value - 1);
        }
        if (!changed)
            c.Flags |= 2;
    }

    // the bytes that differ from the next one by more than the limit move 2 towards it
    void LowPass(ref PlayVoice c, int e2, int e3, int limit, int wave, bool fromWave)
    {
        for (var i = e2; i <= e3; i += 1)
        {
            int value = c.Byte(i);
            int next = i == e3 ? c.Byte(e2) : c.Byte(i + 1);
            bool up = value <= next;
            int diff = S8(value - next);
            if (diff < 0)
                diff = (-diff) & 0xff;
            int max = fromWave ? WaveByte(M.Waves, wave, e3 + i - e2) & 0x7f : S16(limit);
            if (diff > max)
                c.SetByte(i, up ? value + 2 : value - 2);
        }
    }

    // ---- the interrupt (SA_IrqLowLevel) ----

    void Interrupt(int bufferIndex, bool loop)
    {
        for (var v = 0; v < 4; v += 1)
        {
            var c = Voices[v];
            RepeatSample(v, ref c);
            Voices[v] = c;
        }
        bool[] startDma = new bool[4];
        SongSpeedPos += 1;
        if (SongSpeedPos >= Speed)
        {
            SongSpeedPos = 0;
            if (!AdvanceSong(bufferIndex, loop))
                return;
            for (var v = 0; v < 4; v += 1)
            {
                var voice = M.Voices[CurrentPosition * 4 + v];
                var note = M.NoteAt(voice.NoteAddress + OverPatternPos);
                var c = Voices[v];
                startDma[v] = AdvanceVoice(v, ref c, note, voice.NoteTranspose, voice.SoundTranspose);
                Voices[v] = c;
            }
        }
        for (var v = 0; v < 4; v += 1)
        {
            var c = Voices[v];
            ProcessVoice(v, ref c);
            Voices[v] = c;
        }
        for (var v = 0; v < 4; v += 1)
        {
            if (startDma[v])
                StartDma(v);
        }
    }

    // the next row (SA_AdvanceSong): the next row of the pattern, or the first row of the next position; after the stop
    // position the song goes on at the repeat position. Going back to a position played already ends the song, unless
    // it loops. False when the song ended.
    bool AdvanceSong(int bufferIndex, bool loop)
    {
        OverPatternPos += 1;
        if (OverPatternPos < PatternLength && CurrentPosition >= 0)
            return true;
        OverPatternPos = 0;
        OverLinePos += 1;
        if (Song.StopPos < OverLinePos)
            OverLinePos = Song.RepeatPos;
        int position = Math.Max(0, Math.Min(OverLinePos, M.Positions() - 1));
        if (CurrentPosition >= 0 && position <= CurrentPosition)
        {
            if (!loop)
            {
                HasEnd = true;
                EndIndex = Processed + bufferIndex;
                return false;
            }
            LoopCounter += 1;
        }
        CurrentPosition = position;
        return true;
    }

    // ---- making the samples ----

    void Load(int bufferIndex, int numSamples, bool loop)
    {
        double tick = 1.0 / SampleRate;
        double deltaTime = (double)numSamples / SampleRate - 0.1 * tick;
        for (double d = 0.0; d < deltaTime; d += tick)
        {
            if (HasEnd && Processed + bufferIndex >= EndIndex)
                return;
            if (NextInterruptTime <= PlayTime)
            {
                Interrupt(bufferIndex, loop);
                NextInterruptTime += InterruptDelay;
                if (HasEnd && Processed + bufferIndex >= EndIndex)
                    return;
            }
            if (Mode == ChannelMode.Quad)
            {
                for (var v = 0; v < 4; v += 1)
                    Buffer[bufferIndex + v] = ToByte(Filtered(v, ChannelOutput(v)) * 128.0);
                bufferIndex += 4;
            }
            else if (Mode == ChannelMode.Stereo)
            {
                double left = Filtered(0, 0.5 * ChannelOutput(0) + 0.5 * ChannelOutput(3)) * 128.0;
                double right = Filtered(1, 0.5 * ChannelOutput(1) + 0.5 * ChannelOutput(2)) * 128.0;
                Buffer[bufferIndex] = ToByte(left);
                Buffer[bufferIndex + 1] = ToByte(right);
                bufferIndex += 2;
            }
            else
            {
                double output = 0.0;
                for (var v = 0; v < 4; v += 1)
                    output += 0.25 * ChannelOutput(v);
                Buffer[bufferIndex] = ToByte(Filtered(0, output) * 128.0);
                bufferIndex += 1;
            }
            AdvancePaula();
            PlayTime += tick;
        }
    }
}

/// A WAV file of 8-bit samples (signed, as the player makes them), with the header SonicConvert writes (its sizes
/// count the channels twice).
uint8[] WavFile(uint8[] samples, int sampleRate, int channels)
{
    int count = samples.Length;
    var w = List<uint8>.Create(count + 44);
    AddText(w, "RIFF");
    AddLE(w, 38 + count * channels, 4);
    AddText(w, "WAVEfmt ");
    AddLE(w, 16, 4);
    AddLE(w, 1, 2);
    AddLE(w, channels, 2);
    AddLE(w, sampleRate, 4);
    AddLE(w, sampleRate * channels, 4);
    AddLE(w, channels, 2);
    AddLE(w, 8, 2);
    AddText(w, "data");
    AddLE(w, count * channels, 4);
    for (var i = 0; i < count; i += 1)
        w.Add((uint8)((samples[i] + 128) & 0xff));
    return w.ToArray();
}

void AddText(List<uint8> w, StringSlice text)
{
    for (var i = 0; i < text.Length; i += 1)
        w.Add((uint8)text[i]);
}

// a little-endian value of so many bytes
void AddLE(List<uint8> w, int value, int bytes)
{
    for (var i = 0; i < bytes; i += 1)
        w.Add((uint8)((value >> (8 * i)) & 0xff));
}
