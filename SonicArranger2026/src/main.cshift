// SonicArranger2026: a tracker for Sonic Arranger modules, in the spirit of the Amiga original. This first version
// opens modules (the module format "SOAR" and the packed format of the export, also with a replayer before it), shows
// their songs, the over table (the positions with the pattern and transposes of each voice), the instruments and the
// patterns, and saves them in the module format.
//
//   sonicarranger2026 [file]               the tracker, with a file
//   sonicarranger2026 --convert in out     saves a file in the module format, without a window
//   sonicarranger2026 --frames N [file]    draws N frames and closes (for screenshots and tests)

using System;
using System.Image;
using System.Ui;
using SonicArranger;

struct App
{
    Module Song;
    string Path;          // the file of the module, "" for a new one
    string Message;       // what the last open or save did
    int SongIndex;
    int Position;         // the position shown in the pattern view
    int Row;              // the cursor in the pattern view
    int Voice;
    int ScrollRow;        // the first row shown
    int Instrument;       // the selected instrument (0-based)
    int FileMode;         // the file dialog: 0 none, 1 open, 2 save as
    string FilePath;
    bool Dark;
    bool Quit;
}

void Open(ref App app, string path)
{
    if (LoadModule(path) is Module m)
    {
        app.Song = m;
        app.Path = path;
        app.SongIndex = 0;
        app.Position = m.Songs.Count() > 0 ? Math.Max(0, Math.Min(m.Songs[0].StartPos, m.Positions() - 1)) : 0;
        app.Row = 0;
        app.Voice = 0;
        app.ScrollRow = 0;
        app.Instrument = 0;
        app.Message = $"Opened {Path.GetFileName(path)}" + (m.Packed ? " (packed: saved as a module)" : "");
    }
    else
        app.Message = $"Cannot open {Path.GetFileName(path)}: no Sonic Arranger file";
}

void SaveAs(ref App app, string path)
{
    if (SaveModule(app.Song, path) is error e)
    {
        app.Message = $"Cannot save {Path.GetFileName(path)}: {e.Message}";
        return;
    }
    app.Path = path;
    app.Message = $"Saved {Path.GetFileName(path)}";
}

// the song, its timing and where it is in the over table
void SongHeader(Ui ui, ref App app)
{
    var m = app.Song;
    using (ui.Row())
    {
        ui.Label(app.Path.Length > 0 ? Path.GetFileName(app.Path).ToString() : "New module");
        ui.Note(m.Packed ? "packed" : "module " + m.Version);
        if (m.Songs.Count() > 1)
        {
            var names = List<string>.Create();
            for (var i = 0; i < m.Songs.Count(); i += 1)
                names.Add($"Song {i + 1}");
            using (ui.Column(110))
            {
                if (ui.ComboBox("song", ref app.SongIndex, names))
                    app.Position = Math.Max(0, Math.Min(m.Songs[app.SongIndex].StartPos, m.Positions() - 1));
            }
        }
        var song = m.Songs[app.SongIndex];
        ui.Note($"Speed {song.Speed}   Rows {song.PatternLength}   Start {Dec(song.StartPos, 3)}   " +
                $"Stop {Dec(song.StopPos, 3)}   Repeat {Dec(song.RepeatPos, 3)}   {song.TicksPerSecond} Hz   {song.Bpm()} BPM");
        if (m.Owner.Length > 0)
            ui.Tooltip("Owner: " + m.Owner.Replace("\n", " "));
    }
}

// the over table: one line per position, the pattern address and transposes of the 4 voices
void Positions(Ui ui, ref App app)
{
    var m = app.Song;
    var song = m.Songs[app.SongIndex];
    using (ui.Scroll("positions", 190))
    {
        for (var p = 0; p < m.Positions(); p += 1)
        {
            var sb = StringBuilder.Create();
            sb.Append(Dec(p, 3));
            sb.Append(p == song.StartPos ? ">" : (p == song.StopPos ? "<" : " "));
            for (var v = 0; v < 4; v += 1)
            {
                var voice = m.VoiceAt(p, v);
                sb.Append($"  {Hex(voice.NoteAddress, 4)} {Signed(voice.SoundTranspose).PadLeft(3)} {Signed(voice.NoteTranspose).PadLeft(3)}");
            }
            using (ui.Id(p))
            {
                if (ui.ListItem(sb.ToString(), p == app.Position))
                    app.Position = p;
            }
        }
    }
}

// the instruments: number, name and kind
void Instruments(Ui ui, ref App app)
{
    var m = app.Song;
    using (ui.Scroll("instruments", 190))
    {
        for (var i = 0; i < m.Instruments.Count(); i += 1)
        {
            var inst = m.Instruments[i];
            string kind = inst.IsSynth() ? $"wave {inst.SampleWaveNo}" : $"sample {inst.SampleWaveNo}";
            using (ui.Id(i))
            {
                if (ui.ListItem($"{Dec(i + 1, 2)}  {TextOf(inst.Name).PadRight(24)} {kind}", i == app.Instrument))
                    app.Instrument = i;
                ui.Tooltip($"Volume {inst.Volume}, {EffectName(inst.Effect)}");
            }
        }
    }
}

// the keys of the tracker: the cursor and the positions
void TrackerKeys(Ui ui, ref App app)
{
    var input = ui.Input();
    int rows = Math.Max(1, app.Song.Songs[app.SongIndex].PatternLength);
    if (input.Pressed(Key.Up))
        app.Row = (app.Row + rows - 1) % rows;
    if (input.Pressed(Key.Down))
        app.Row = (app.Row + 1) % rows;
    if (input.Pressed(Key.Left))
        app.Voice = (app.Voice + 3) % 4;
    if (input.Pressed(Key.Right))
        app.Voice = (app.Voice + 1) % 4;
    if (input.Pressed(Key.Home))
        app.Row = 0;
    if (input.Pressed(Key.End))
        app.Row = rows - 1;
    if (input.Pressed(Key.PageUp))
        app.Position = Math.Max(0, app.Position - 1);
    if (input.Pressed(Key.PageDown))
        app.Position = Math.Min(app.Song.Positions() - 1, app.Position + 1);
}

void Draw(Ui ui, ref App app)
{
    var input = ui.Input();
    using (ui.MenuBar())
    {
        using (ui.Menu("File"))
        {
            if (ui.MenuItem("New"))
            {
                app.Song = Module.Create();
                app.Path = "";
                app.Position = 0;
                app.Row = 0;
                app.Message = "";
            }
            if (ui.MenuItem("Open...", "Ctrl+O"))
                app.FileMode = 1;
            if (ui.MenuItem("Save as...", "Ctrl+S"))
                app.FileMode = 2;
            if (ui.MenuItem("Quit", "Ctrl+Q"))
                app.Quit = true;
        }
        using (ui.Menu("View"))
        {
            if (ui.MenuItem(app.Dark ? "Light theme" : "Dark theme"))
            {
                app.Dark = !app.Dark;
                ui.SetTheme(app.Dark ? Theme.Dark() : Theme.Light());
            }
        }
    }
    if (input.Pressed(Key.O, KeyModifiers.Ctrl))
        app.FileMode = 1;
    if (input.Pressed(Key.S, KeyModifiers.Ctrl))
        app.FileMode = 2;
    if (input.Pressed(Key.Q, KeyModifiers.Ctrl) || input.CloseRequested)
        app.Quit = true;

    SongHeader(ui, ref app);
    using (ui.Row())
    {
        using (ui.Column(560))
        {
            ui.Note("Positions: the pattern (note address), sound and note transpose of the 4 voices");
            Positions(ui, ref app);
        }
        using (ui.Column())
        {
            ui.Note("Instruments");
            Instruments(ui, ref app);
        }
    }
    if (app.Message.Length > 0)
        ui.Note(app.Message);
    if (app.FileMode == 0)
        TrackerKeys(ui, ref app);
    PatternView(ui, ref app);

    if (app.FileMode != 0)
    {
        bool open = app.FileMode == 1;
        var result = ui.FileDialog("file", open ? "Open a module" : "Save the module", ref app.FilePath,
                                   open ? FileDialogMode.Open : FileDialogMode.Save);
        if (result == UiDialogResult.Ok)
        {
            if (open)
                Open(ref app, app.FilePath);
            else
                SaveAs(ref app, app.FilePath);
        }
        if (result != UiDialogResult.None)
            app.FileMode = 0;
    }
}

int Main(string[] args)
{
    if (args.Length == 3 && args[0] == "--convert")
    {
        var m = try LoadModule(args[1]);
        try SaveModule(m, args[2]);
        return 0;
    }
    int frames = 0;
    string file = "";
    for (var i = 0; i < args.Length; i += 1)
    {
        if (args[i] == "--frames" && i + 1 < args.Length && args[i + 1].ParseInt() is int n)
        {
            frames = n;
            i += 1;
        }
        else
            file = args[i];
    }

    var window = try Window.Open("SonicArranger2026", 1100, 760);
    var ui = Ui.Create();
    ui.SetTheme(Theme.Dark());
    var app = App { Song = Module.Create(), Path = "", Message = "", FilePath = "", Dark = true };
    if (file.Length > 0)
        Open(ref app, file);
    int count = 0;
    while (!app.Quit && window.Update())
    {
        ui.Begin(window);
        Draw(ui, ref app);
        if (frames > 0)
            window.Show(ui.End());
        else
            window.Show(ui);
        count += 1;
        if (frames > 0 && count >= frames)
            break;
    }
    window.Dispose();
    return 0;
}
