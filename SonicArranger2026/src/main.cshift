// SonicArranger2026: a tracker for Sonic Arranger modules, in the spirit of the Amiga original. It opens modules (the
// module format "SOAR" and the packed format of the export, also with a replayer before it), shows and edits their
// songs, the over table (the positions with the pattern and transposes of each voice) and the patterns, and saves them
// in the module format.
//
//   sonicarranger2026 [file]               the tracker, with a file
//   sonicarranger2026 --convert in out     saves a file in the module format, without a window
//   sonicarranger2026 --wav in out.wav [options]  plays a song into a WAV file, without a window: -t<n> the song
//                                          (0-based), -r<n> the sample rate (44100), -s stereo (LRRL), -q 4 channels,
//                                          -d no low pass filter, -n NTSC, -i interpolate, -l<n> loops (as SonicConvert)
//   sonicarranger2026 --frames N [file]    draws N frames and closes (for screenshots and tests)

using System;
using System.Image;
using System.Ui;
using SonicArranger;

struct App
{
    Module Song;
    History History;      // undo and redo
    bool Modified;        // changed since it was opened or saved
    string Path;          // the file of the module, "" for a new one
    string Message;       // what the last open or save did
    int SongIndex;
    int Position;         // the position shown in the pattern view
    int Row;              // the cursor in the pattern view
    int Voice;
    int Column;           // the column of the cell: 0 note, 1-2 instrument, 3-6 note options
    int ScrollRow;        // the first row shown
    int Instrument;       // the selected instrument (0-based): the one a new note gets
    bool EditMode;        // keys change the pattern (Space switches)
    int Octave;           // of the lower row of the piano keys (F1 to F8: 0 to 7)
    int Step;             // rows the cursor moves after a note is entered
    int FileMode;         // the file dialog: 0 none, 1 open, 2 save as, 3 export WAV
    string FilePath;
    int Discard;          // asks before the changes are lost: 0 no, 1 for New, 2 for Open, 3 for Quit
    bool Dark;
    bool Quit;
}

// a module to work on: everything that belonged to the last one is reset
void SetModule(ref App app, Module m, string path)
{
    app.Song = m;
    app.History = History.Create();
    app.Modified = false;
    app.Path = path;
    app.SongIndex = 0;
    app.Position = Math.Max(0, Math.Min(m.Songs[0].StartPos, m.Positions() - 1));
    app.Row = 0;
    app.Voice = 0;
    app.Column = 0;
    app.ScrollRow = 0;
    app.Instrument = 0;
}

void Open(ref App app, string path)
{
    if (LoadModule(path) is Module m)
    {
        SetModule(ref app, m, path);
        app.Message = $"Opened {Path.GetFileName(path)}" + (m.Packed ? " (packed: saved as a module)" : "");
    }
    else
        app.Message = $"Cannot open {Path.GetFileName(path)}: no Sonic Arranger file";
}

void SaveAs(ref App app, string path)
{
    if (SaveModule(app.Song, path) is error e)
    {
        app.Message = $"Cannot save {Path.GetFileName(path)}: {e.Message}";
        return;
    }
    app.Path = path;
    app.Modified = false;
    app.History.Break();
    app.Message = $"Saved {Path.GetFileName(path)}";
}

// File > Export WAV: the save dialog, with the name of the module and .wav
void StartExport(ref App app)
{
    string name = app.Path.Length > 0 ? Path.GetFileName(app.Path).ToString() : "song";
    app.FilePath = name + ".wav";
    app.FileMode = 3;
}

// plays the song shown into a WAV file: mono, 44.1 kHz, as SonicConvert does by default
void ExportSong(ref App app, string path)
{
    if (Player.Create(app.Song, app.SongIndex, 44100, ChannelMode.Mono, true, true, false) is not Player player)
    {
        app.Message = "The song cannot be played (speed 1 to 16, 1 to 200 ticks per second)";
        return;
    }
    var samples = player.ReadAll(0);
    if (File.WriteAllBytes(path, WavFile(samples, 44100, 1)) is error e)
    {
        app.Message = $"Cannot write {Path.GetFileName(path)}";
        return;
    }
    int seconds = samples.Length / 44100;
    app.Message = $"Exported {Path.GetFileName(path)} ({seconds / 60}:{Dec(seconds % 60, 2)})";
}

// New, Open and Quit: at once, or after asking when there are changes
void Ask(ref App app, int what)
{
    if (app.Modified)
    {
        app.Discard = what;
        return;
    }
    Do(ref app, what);
}

void Do(ref App app, int what)
{
    if (what == 1)
    {
        SetModule(ref app, Module.Create(), "");
        app.Message = "";
    }
    else if (what == 2)
        app.FileMode = 1;
    else if (what == 3)
        app.Quit = true;
}

void Undo(ref App app)
{
    if (!app.History.CanUndo())
        return;
    app.History.UndoOnce(ref app.Song);
    app.Modified = true;
    KeepInRange(ref app);
}

void Redo(ref App app)
{
    if (!app.History.CanRedo())
        return;
    app.History.RedoOnce(ref app.Song);
    app.Modified = true;
    KeepInRange(ref app);
}

// the position and the song stay in the module after positions are removed or a change is undone
void KeepInRange(ref App app)
{
    app.Position = Math.Max(0, Math.Min(app.Position, app.Song.Positions() - 1));
    app.SongIndex = Math.Max(0, Math.Min(app.SongIndex, app.Song.Songs.Count() - 1));
}

void Draw(Ui ui, ref App app)
{
    var input = ui.Input();
    bool dialog = app.FileMode != 0 || app.Discard != 0;
    using (ui.MenuBar())
    {
        using (ui.Menu("File"))
        {
            if (ui.MenuItem("New"))
                Ask(ref app, 1);
            if (ui.MenuItem("Open...", "Ctrl+O"))
                Ask(ref app, 2);
            if (ui.MenuItem("Save as...", "Ctrl+S"))
                app.FileMode = 2;
            if (ui.MenuItem("Export WAV...", "Ctrl+E"))
                StartExport(ref app);
            if (ui.MenuItem("Quit", "Ctrl+Q"))
                Ask(ref app, 3);
        }
        using (ui.Menu("Edit"))
        {
            if (ui.MenuItem("Undo", "Ctrl+Z"))
                Undo(ref app);
            if (ui.MenuItem("Redo", "Ctrl+Y"))
                Redo(ref app);
            if (ui.MenuItem(app.EditMode ? "Stop editing" : "Edit the pattern", "Space"))
                app.EditMode = !app.EditMode;
            if (ui.MenuItem("Insert position", "Ctrl+I"))
                InsertPositionHere(ref app);
            if (ui.MenuItem("Remove position", "Ctrl+Del"))
                RemovePositionHere(ref app);
            if (ui.MenuItem("New pattern for the voice", "Ctrl+N"))
                NewPatternHere(ref app, false);
            if (ui.MenuItem("Copy of the pattern for the voice", "Ctrl+D"))
                NewPatternHere(ref app, true);
        }
        using (ui.Menu("View"))
        {
            if (ui.MenuItem(app.Dark ? "Light theme" : "Dark theme"))
            {
                app.Dark = !app.Dark;
                ui.SetTheme(app.Dark ? Theme.Dark() : Theme.Light());
            }
        }
    }
    if (!dialog)
    {
        if (input.Pressed(Key.O, KeyModifiers.Ctrl))
            Ask(ref app, 2);
        if (input.Pressed(Key.S, KeyModifiers.Ctrl))
            app.FileMode = 2;
        if (input.Pressed(Key.E, KeyModifiers.Ctrl))
            StartExport(ref app);
        if (input.Pressed(Key.Q, KeyModifiers.Ctrl))
            Ask(ref app, 3);
    }
    if (input.CloseRequested)
        Ask(ref app, 3);

    SongHeader(ui, ref app);
    using (ui.Row())
    {
        using (ui.Column(560))
        {
            ui.Note("Positions: the pattern (note address), sound and note transpose of the 4 voices");
            Positions(ui, ref app);
        }
        using (ui.Column())
        {
            ui.Note("Instruments");
            Instruments(ui, ref app);
        }
    }
    SongEditor(ui, ref app);
    PositionEditor(ui, ref app);
    StatusLine(ui, ref app);
    if (!dialog && !EditorFocused(ui))
        TrackerKeys(ui, ref app);
    PatternView(ui, ref app);

    if (app.FileMode != 0)
    {
        bool open = app.FileMode == 1;
        string title = open ? "Open a module" : (app.FileMode == 2 ? "Save the module" : "Export the song as WAV");
        var result = ui.FileDialog("file", title, ref app.FilePath, open ? FileDialogMode.Open : FileDialogMode.Save);
        if (result == UiDialogResult.Ok)
        {
            if (open)
                Open(ref app, app.FilePath);
            else if (app.FileMode == 2)
                SaveAs(ref app, app.FilePath);
            else
                ExportSong(ref app, app.FilePath);
        }
        if (result != UiDialogResult.None)
            app.FileMode = 0;
    }
    if (app.Discard != 0)
    {
        using (ui.Modal("discard", "Discard the changes?"))
        {
            ui.Text("The module has changes that are not saved.");
            using (ui.Row())
            {
                if (ui.Button("Discard"))
                {
                    int what = app.Discard;
                    app.Discard = 0;
                    Do(ref app, what);
                }
                if (ui.Button("Cancel") || input.Pressed(Key.Escape))
                    app.Discard = 0;
            }
        }
    }
}

// --wav: the options of SonicConvert
int ExportWav(string[] args)
{
    int song = 0;
    int rate = 44100;
    int loops = 0;
    var mode = ChannelMode.Mono;
    bool filter = true;
    bool pal = true;
    bool interpolate = false;
    for (var i = 3; i < args.Length; i += 1)
    {
        var a = args[i];
        if (a == "-s")
            mode = ChannelMode.Stereo;
        else if (a == "-q")
            mode = ChannelMode.Quad;
        else if (a == "-d")
            filter = false;
        else if (a == "-n")
            pal = false;
        else if (a == "-i")
            interpolate = true;
        else if (a.Length > 2 && a[0..2].ToString() == "-t" && a[2..].ToString().ParseInt() is int t)
            song = t;
        else if (a.Length > 2 && a[0..2].ToString() == "-r" && a[2..].ToString().ParseInt() is int r)
            rate = r;
        else if (a.Length > 2 && a[0..2].ToString() == "-l" && a[2..].ToString().ParseInt() is int l)
            loops = Math.Min(100, l);
        else
        {
            Console.WriteLine($"error: unknown option {a}");
            return 1;
        }
    }
    if (LoadModule(args[1]) is not Module m)
    {
        Console.WriteLine($"error: cannot load {args[1]}");
        return 1;
    }
    if (Player.Create(m, song, rate, mode, filter, pal, interpolate) is not Player player)
    {
        Console.WriteLine("error: the song cannot be played (song, sample rate, speed or ticks per second)");
        return 1;
    }
    var samples = player.ReadAll(loops);
    if (File.WriteAllBytes(args[2], WavFile(samples, rate, (int)mode)) is error e)
    {
        Console.WriteLine($"error: cannot write {args[2]}");
        return 1;
    }
    return 0;
}

int Main(string[] args)
{
    if (args.Length == 3 && args[0] == "--convert")
    {
        var m = try LoadModule(args[1]);
        try SaveModule(m, args[2]);
        return 0;
    }
    if (args.Length >= 3 && args[0] == "--wav")
        return ExportWav(args);
    int frames = 0;
    string file = "";
    for (var i = 0; i < args.Length; i += 1)
    {
        if (args[i] == "--frames" && i + 1 < args.Length && args[i + 1].ParseInt() is int n)
        {
            frames = n;
            i += 1;
        }
        else
            file = args[i];
    }

    var window = try Window.Open("SonicArranger2026", 1100, 800);
    window.ConfirmClose(true); // closing the window asks first when there are changes
    var ui = Ui.Create();
    ui.SetTheme(Theme.Dark());
    var app = App { Message = "", FilePath = "", Dark = true, Octave = 2, Step = 1 };
    SetModule(ref app, Module.Create(), "");
    if (file.Length > 0)
        Open(ref app, file);
    int count = 0;
    while (!app.Quit && window.Update())
    {
        ui.Begin(window);
        Draw(ui, ref app);
        if (frames > 0)
            window.Show(ui.End());
        else
            window.Show(ui);
        count += 1;
        if (frames > 0 && count >= frames)
            break;
    }
    window.Dispose();
    return 0;
}
