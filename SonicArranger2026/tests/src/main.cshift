// The tests of the module library: a module made in code is saved and read back unchanged; changing notes, positions
// and patterns, and undo; every file given is read, saved in the module format and read back; a module file must come
// out byte for byte the same. With --out, each file is saved into that folder in the module format (name.soar) and
// with a note changed (name.edited), for tests/run.sh, which converts them with SonicConvert and compares.
//
//   sa2026-tests [--out folder] [files...]

using System;
using SonicArranger;

int failures = 0;

void Check(bool ok, StringSlice what)
{
    if (!ok)
    {
        Console.WriteLine("FAILED: " + what);
        failures += 1;
    }
}

bool SameBytes(uint8[] a, uint8[] b)
{
    if (a.Length != b.Length)
        return false;
    for (var i = 0; i < a.Length; i += 1)
    {
        if (a[i] != b[i])
            return false;
    }
    return true;
}

// a module made in code: a song, a note with a command, a synth instrument, a sample, a wave of each kind
void TestMadeInCode()
{
    var m = Module.Create();
    m.Notes[0] = Note { Value = 37, Instrument = 1, Flags = 0x9f, Param = 0x04 };
    m.Notes[1] = Note { Value = 108, Instrument = 2, Flags = 0x0c, Param = 0x40 };
    var inst = Instrument { SynthMode = 1, Length = 32, Volume = 64, VibDelay = 255, VibSpeed = 18, VibLevel = 160,
                            AdsrDelay = 1, AmfDelay = 1, Unknown8 = new uint8[8], Unknown16 = new uint8[16],
                            Effect = 17, Effect1 = -3, Arpeggios = new Arpeggio[3], Name = NameBytes("Synth bass", 30) };
    for (var i = 0; i < 3; i += 1)
        inst.Arpeggios[i] = Arpeggio { Length = i, Data = new uint8[14] };
    m.Instruments.Add(inst);
    var wave = new uint8[128];
    for (var i = 0; i < 128; i += 1)
        wave[i] = (uint8)(i * 2);
    m.Waves.Add(wave);
    m.AdsrWaves.Add(new uint8[128]);
    m.AmfWaves.Add(new uint8[128]);
    m.Samples.Add(Sample { Data = new uint8[] { 1, 2, 3, 250 }, Length = 2, Repeat = 1, Name = NameBytes("Drum", 30) });
    m.Voices[2] = Voice { NoteAddress = 0, SoundTranspose = -2, NoteTranspose = 12 };

    var bytes = WriteSoar(m);
    Check(TextOf(bytes[0..4].ToArray()) == "SOAR", "a saved module starts with SOAR");
    if (ReadModule(bytes) is not Module back)
    {
        Check(false, "a module made in code can be read back");
        return;
    }
    Check(SameBytes(WriteSoar(back), bytes), "a module made in code is saved the same after reading it back");
    Check(back.Notes[0].Command() == 0xf && back.Notes[0].Arpeggio() == 1 && back.Notes[0].NoSoundTranspose(),
          "the flags of a note");
    Check(back.Voices[2].SoundTranspose == -2 && back.Voices[2].NoteTranspose == 12, "signed transposes");
    Check(back.Instruments[0].Effect1 == -3 && TextOf(back.Instruments[0].Name) == "Synth bass", "an instrument");
    Check(back.Samples[0].Data[3] == 250 && TextOf(back.Samples[0].Name) == "Drum", "a sample");
    Check(back.Songs[0].Bpm() == 125, "125 BPM at speed 6 and 50 ticks per second");
    Check(NoteName(37) == "C-3" && NoteName(0) == "---" && NoteName(2) == "C#0", "note names");

    // damaged data
    Check(ReadModule(bytes[0..100].ToArray()) is error, "a cut module is an error");
    Check(ReadModule(new uint8[] { 1, 2, 3, 4, 5, 6, 7, 8, 9 }) is error, "data without Sonic Arranger is an error");
}

// changing notes, positions and patterns, and undo
void TestEditing()
{
    var note = new Note();
    note = WithDigit(note, 3, 0xa);
    note = WithDigit(note, 4, 0xc);
    note = WithDigit(note, 5, 0x3);
    note = WithDigit(note, 6, 0xf);
    Check(note.Flags == 0xac && note.Param == 0x3f, "the 4 hex digits of the note options");
    note = WithDigit(note, 1, 1);
    note = WithDigit(note, 2, 7);
    Check(note.Instrument == 17, "the two digits of the instrument");
    Check(WithDigit(note, 2, 12).Instrument == 17, "an instrument digit is 0 to 9");
    var cleared = Cleared(note, 5);
    Check(cleared.Flags == 0xa0 && cleared.Param == 0 && cleared.Instrument == 17, "clearing the command keeps the flags");
    note.Value = 40;
    cleared = Cleared(note, NoteColumn);
    Check(cleared.Value == 0 && cleared.Instrument == 0 && cleared.Param == 0x3f, "clearing the note and instrument");
    Check(PianoKey(0, 3) == 37 && PianoKey(12, 3) == 49 && PianoKey(-1, 3) == -1 && PianoKey(11, 8) == 108 &&
          PianoKey(12, 8) == -1, "piano keys");
    Check(NoteName(PianoKey(9, 2)) == "A-2", "A of octave 2");

    // positions: the song after the insert point moves, a song ending at it gets longer
    var m = Module.Create();
    m.Songs[0] = SongInfo { Speed = 6, PatternLength = 64, StartPos = 0, StopPos = 0, RepeatPos = 0, TicksPerSecond = 50 };
    m.Songs.Add(SongInfo { Speed = 6, PatternLength = 64, StartPos = 1, StopPos = 1, RepeatPos = 1, TicksPerSecond = 50 });
    InsertPosition(ref m, 0);
    Check(m.Positions() == 2 && m.Songs[0].StopPos == 1 && m.Songs[1].StartPos == 2 && m.Songs[1].StopPos == 2,
          "inserting a position after the end of song 1");
    m.Voices[4] = Voice { NoteAddress = 5, SoundTranspose = 1, NoteTranspose = -1 };
    RemovePosition(ref m, 0);
    Check(m.Positions() == 1 && m.VoiceAt(0, 0).NoteAddress == 5 && m.Songs[0].StopPos == 0 && m.Songs[1].StartPos == 0,
          "removing a position");
    RemovePosition(ref m, 0);
    Check(m.Positions() == 1, "the last position stays");

    // patterns: a new one at the end of the note table, a copy keeps the notes
    m.Notes[3] = Note { Value = 50, Instrument = 2 };
    int fresh = NewPattern(ref m, 64);
    int copy = CopyPattern(ref m, 0, 64);
    Check(fresh == 256 && copy == 320 && m.Notes.Count() == 384 && m.Notes[323].Value == 50 && m.Notes[259].Value == 0,
          "new and copied patterns");
    Check(Module.Create().VoiceAt(0, 3).NoteAddress == 192, "a new module has a pattern for each voice");

    // undo and redo; changes of one kind in a row are one step
    var h = History.Create();
    h.Before(m, "Note", "");
    SetNote(ref m, 0, Note { Value = 1 });
    h.Before(m, "Speed", "speed");
    var song = m.Songs[0];
    song.Speed = 3;
    m.Songs[0] = song;
    h.Before(m, "Speed", "speed");
    song.Speed = 4;
    m.Songs[0] = song;
    Check(h.Undo.Count() == 2, "changes of one box in a row are one step");
    h.UndoOnce(ref m);
    Check(m.Songs[0].Speed == 6 && m.Notes[0].Value == 1, "undo of the speed");
    h.UndoOnce(ref m);
    Check(m.Notes[0].Value == 0, "undo of the note");
    h.RedoOnce(ref m);
    h.RedoOnce(ref m);
    Check(m.Notes[0].Value == 1 && m.Songs[0].Speed == 4 && !h.CanRedo(), "redo");
    h.Before(m, "Note", "");
    Check(!h.CanRedo(), "a change clears redo");
}

// the replayer on a module made in code: a synth wave played for one pattern
void TestPlayer()
{
    var m = Module.Create();
    m.Songs[0] = SongInfo { Speed = 6, PatternLength = 16, StartPos = 0, StopPos = 0, RepeatPos = 0, TicksPerSecond = 50 };
    var wave = new uint8[128];
    for (var i = 0; i < 128; i += 1)
        wave[i] = (uint8)(i < 64 ? 100 : 156); // a square wave: +100, -100
    m.Waves.Add(wave);
    var inst = Instrument { SynthMode = 1, SampleWaveNo = 0, Length = 64, Volume = 64, VibDelay = 255, AmfDelay = 1,
                            AdsrDelay = 1, Unknown8 = new uint8[8], Unknown16 = new uint8[16], Arpeggios = new Arpeggio[3],
                            Name = NameBytes("Square", 30) };
    for (var i = 0; i < 3; i += 1)
        inst.Arpeggios[i] = Arpeggio { Data = new uint8[14] };
    m.Instruments.Add(inst);
    m.Notes[0] = Note { Value = 37, Instrument = 1 };
    if (Player.Create(m, 0, 8000, ChannelMode.Mono, false, true, false) is not Player p)
    {
        Check(false, "a player for a module made in code");
        return;
    }
    var samples = p.ReadAll(0);
    // 16 rows of 6 ticks at 50 Hz: the end is found when the last row starts, and that row is played: 1.92 s
    Check(samples.Length >= 15300 && samples.Length <= 15400, $"the length of the song: {samples.Length} samples");
    int loud = 0;
    foreach (var b in samples)
    {
        if (S8(b) > 20 || S8(b) < -20)
            loud += 1;
    }
    Check(loud > samples.Length / 2, "the square wave is heard");
    var wav = WavFile(samples, 8000, 1);
    Check(TextOf(wav[0..4].ToArray()) == "RIFF" && wav.Length == samples.Length + 44 && wav[44] == (uint8)((samples[0] + 128) & 0xff),
          "a WAV file");
    Check(Player.Create(m, 1, 8000, ChannelMode.Mono, false, true, false) is error, "there is no second song");
    if (Player.Create(m, 0, 8000, ChannelMode.Stereo, true, true, false) is Player stereo)
        Check(stereo.ReadAll(0).Length % 2 == 0, "stereo: whole samples of 2 channels");
    else
        Check(false, "a stereo player");
}

// the module with a note changed at the start of its first song (voice 1, row 0): to check that an edited module
// still converts
Module Edited(Module m)
{
    var copy = m;
    copy.Notes = m.Notes.Select(n => n);
    int address = m.VoiceAt(Math.Max(0, Math.Min(m.Songs[0].StartPos, m.Positions() - 1)), 0).NoteAddress;
    var note = m.NoteAt(address);
    note.Value = note.Value == 37 ? 49 : 37;
    note.Instrument = m.Instruments.Count() > 0 ? 1 : 0;
    SetNote(ref copy, address, note);
    return copy;
}

void TestFile(StringSlice path, StringSlice outDir)
{
    var read = File.ReadAllBytes(path);
    if (read is not uint8[] data)
    {
        Check(false, "cannot read " + path);
        return;
    }
    if (ReadModule(data) is not Module m)
    {
        Check(false, "cannot load " + path);
        return;
    }
    var saved = WriteSoar(m);
    if (!m.Packed)
        Check(SameBytes(saved, data), path.ToString() + ": saved again byte for byte");
    if (ReadModule(saved) is Module back)
        Check(SameBytes(WriteSoar(back), saved), path.ToString() + ": the saved module is read back the same");
    else
        Check(false, path.ToString() + ": the saved module cannot be loaded");
    Console.WriteLine($"{Path.GetFileName(path)}: {(m.Packed ? "packed" : "module " + m.Version)}, {m.Songs.Count()} songs, " +
                      $"{m.Positions()} positions, {m.Notes.Count()} notes, {m.Instruments.Count()} instruments, " +
                      $"{m.Samples.Count()} samples, {m.Waves.Count()} waves{(m.Owner.Length > 0 ? ", by " + m.Owner : "")}");
    if (outDir.Length > 0)
    {
        if (File.WriteAllBytes(Path.Combine(outDir, Path.GetFileName(path).ToString() + ".soar"), saved) is error e)
            Check(false, "cannot write into " + outDir);
        var edited = Edited(m);
        if (File.WriteAllBytes(Path.Combine(outDir, Path.GetFileName(path).ToString() + ".edited"), WriteSoar(edited)) is error e2)
            Check(false, "cannot write into " + outDir);
    }
}

int Main(string[] args)
{
    TestMadeInCode();
    TestEditing();
    TestPlayer();
    string outDir = "";
    for (var i = 0; i < args.Length; i += 1)
    {
        if (args[i] == "--out" && i + 1 < args.Length)
        {
            outDir = args[i + 1];
            i += 1;
        }
        else
            TestFile(args[i], outDir);
    }
    if (failures > 0)
    {
        Console.WriteLine($"{failures} checks failed");
        return 1;
    }
    Console.WriteLine("all checks passed");
    return 0;
}
